{
    "name": "lumeweb/cast",
    "type": "project",
    "description": "Cast — a WordPress onboarding plugin built on the ComposePress framework.",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2",
        "ankitpokhrel/tus-php": "^2.4",
        "composepress/core": "dev-master",
        "guzzlehttp/guzzle": "^7.15",
        "guzzlehttp/psr7": "^2.13",
        "mlocati/ip-lib": "^1.22",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "woocommerce/action-scheduler": "^4.2",
        "yohang/finite": "^2.0"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "roots/wordpress-core-installer": "^2.0",
        "roots/wordpress-no-content": "^7.1",
        "squizlabs/php_codesniffer": "^3.13",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "roots/wordpress-core-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:ComposePress/core.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "LumeWeb\\Cast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LumeWeb\\Cast\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "test:integration": "phpunit -c phpunit.integration.xml.dist",
        "test:js": "node --test tests/js/*.test.js",
        "analyse": "phpstan analyse",
        "style": "phpcs --standard=.phpcs.xml.dist src tests"
    },
    "extra": {
        "wordpress-install-dir": "var/wordpress"
    }
}
